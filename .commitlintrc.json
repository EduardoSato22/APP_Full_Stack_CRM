{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [2, "always", [
      "feat", "fix", "perf", "refactor", "test",
      "docs", "chore", "ci", "build", "style", "revert"
    ]],
    "subject-max-length": [2, "always", 100],
    "body-max-line-length": [1, "always", 150]
  }
}
